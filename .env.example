# Vehicle Log Management System (VLMS) Environment Variables Example
# Duplicate this file to .env.local and populate with your credentials

# Supabase Public Configuration (Safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-side Service Role (KEEP SECRET, NEVER EXPOSE TO FRONTEND)
# Used exclusively inside protected server actions & route handlers for administrative provisioning
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TIMEZONE=Africa/Lagos
NEXT_PUBLIC_DEFAULT_CURRENCY=NGN
NEXT_PUBLIC_FIXED_TOM_VENDOR="TOTAL ENERGIES FILLING STATION"

# Optional External Integrations
# If not provided, the application falls back gracefully to interactive OpenStreetMap preview
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
